# ==============================================================================
# PatchScope Environment Configuration Template
# Copy to .env for local development or production deployment.
# Never commit real private keys, secrets, or sensitive tokens.
# ==============================================================================

# Public Client Configuration (Vite-exposed)
# ------------------------------------------------------------------------------
# GenLayer Studionet RPC endpoint
VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# GenLayer Studionet Chain ID (61999 / 0xf22f)
VITE_GENLAYER_CHAIN_ID=61999

# Deployed PatchScope Contract Address on Studionet
VITE_GENLAYER_CONTRACT_ADDRESS=0x7aFa58C5CF4E0145Bbb8B9C508036EeBc349C2Df

# Optional WalletConnect Cloud Project ID (if empty, injected wallets like MetaMask are used)
VITE_WALLETCONNECT_PROJECT_ID=

# Server & Database Configuration (Server-only)
# ------------------------------------------------------------------------------
# Server host and port
PORT=8080
HOST=0.0.0.0

# Database URL for PostgreSQL (if unset, internal PGLite fallback is used automatically)
DATABASE_URL=

# Session Secret for session encryption
SESSION_SECRET=

# Allowed App Origins (comma-separated)
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
